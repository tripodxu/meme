# 复制为 .env 后填入真实值（cp .env.example .env）。.env 已被 .gitignore 忽略。
#
# JEV_API_KEY  必填。只从环境变量读取，不打印、不写日志、不进摘要。
# JEV_ENDPOINT 可选。缺省回落到官方地址 https://api.typesafe.ai/v1/systemone；
#              但官方端点在受限网络下返回 451，现有 Key 也只对自建网关有效，
#              故实测时须显式指向 https://jev.logicc.top/v1/systemone。
# JEV_MODEL    可选。缺省 jev-1.13.0；网关会把它归一化为 jev-1.13-free，
#              判断真实模型请看响应体的 model 字段。

JEV_API_KEY=
JEV_ENDPOINT=https://jev.logicc.top/v1/systemone
JEV_MODEL=jev-1.13.0
